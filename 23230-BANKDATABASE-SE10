QUERY3 - FIND PAIRS OF NAMES OF DIFFERENT CUSTOMERS WHO LIVE AT SAME ADDRESS BUT HAVE ACCOUNTS AT DIFFERENT BRANCHES
mysql> SELECT C1.C_Name, C1.C_citystreet, A1.B_Name AS Branch_1, A2.B_Name AS Branch_2
    -> FROM Customer C1
    -> JOIN Depositor D1 ON C1.C_No = D1.C_No
    -> JOIN Account A1 ON D1.Acc_No = A1.Acc_No
    -> JOIN Depositor D2 ON C1.C_No = D2.C_No
    -> JOIN Account A2 ON D2.Acc_No = A2.Acc_No
    -> WHERE A1.B_Name != A2.B_Name
    -> GROUP BY C1.C_No, A1.B_Name, A2.B_Name;
